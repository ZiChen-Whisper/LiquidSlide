{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@liquid-dom/core": ["./vendor/liquid-dom/index.d.ts"] },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@webgpu/types", "vitest/globals"]
  },
  "include": ["src", "webpack.config.cjs"]
}
